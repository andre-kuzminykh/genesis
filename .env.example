# --- Process Automation Designer ---

# LLM Configuration (OpenAI-compatible endpoint)
PA_LLM_API_KEY=sk-your-key-here
PA_LLM_BASE_URL=https://api.openai.com/v1
PA_LLM_MODEL=gpt-4o
PA_LLM_TEMPERATURE=0.3
PA_LLM_MAX_TOKENS=4096

